{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nhk.example/schemas/codex-orchestrator-result-v1.json",
  "title": "NHK Codex Orchestrator Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "task_id",
    "gate_id",
    "status",
    "base_sha",
    "head_sha",
    "root_cause",
    "actions_taken",
    "files_changed",
    "tests_run",
    "verification",
    "mutations",
    "blockers",
    "recommended_next_step"
  ],
  "properties": {
    "protocol_version": {"const": "1.0"},
    "task_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "gate_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "status": {"enum": ["PASS", "NEEDS_FIX", "BLOCKED", "HUMAN_GATE", "NOOP"]},
    "base_sha": {"type": "string", "minLength": 7, "maxLength": 64},
    "head_sha": {"type": ["string", "null"], "maxLength": 64},
    "root_cause": {"type": "string", "maxLength": 4000},
    "actions_taken": {
      "type": "array",
      "maxItems": 100,
      "items": {"type": "string", "maxLength": 1000}
    },
    "files_changed": {
      "type": "array",
      "maxItems": 500,
      "items": {"type": "string", "maxLength": 500}
    },
    "tests_run": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "exit_code", "summary"],
        "properties": {
          "command": {"type": "string", "maxLength": 1000},
          "exit_code": {"type": "integer", "minimum": -255, "maximum": 255},
          "summary": {"type": "string", "maxLength": 4000}
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope_satisfied", "independent_checks_passed"],
      "properties": {
        "scope_satisfied": {"type": "boolean"},
        "independent_checks_passed": {"type": "boolean"}
      }
    },
    "mutations": {
      "type": "array",
      "maxItems": 100,
      "items": {"type": "string", "maxLength": 1000}
    },
    "blockers": {
      "type": "array",
      "maxItems": 100,
      "items": {"type": "string", "maxLength": 1000}
    },
    "recommended_next_step": {"type": "string", "maxLength": 4000}
  }
}
