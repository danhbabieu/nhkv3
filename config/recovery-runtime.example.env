# Non-secret example only. Do not copy credentials into Git or snapshots.
NHK_RUNTIME_ENVIRONMENT=v3-video-recovery-1309
NHK_RUNTIME_MODE=recovery
WP_ENVIRONMENT_TYPE=development
WP_HOME=https://video-recovery.example.invalid
WP_SITEURL=https://video-recovery.example.invalid
DB_NAME=nhk_v3_video_recovery
DB_USER=provided-outside-git
DB_PASSWORD=provided-outside-git
DB_HOST=provided-outside-git
DB_PREFIX=wp_
NHK_RECOVERY_ALLOWED_DATABASES=nhk_v3_video_recovery
# The snapshot source database identity must never equal DB_NAME.
