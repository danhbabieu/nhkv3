{
  "name": "nhk/nhk-v3",
  "description": "NHK v3 - WordPress clean architecture foundation",
  "type": "project",
  "require": {"symfony/uid": "^7.3"},
  "require-dev": {"phpunit/phpunit": "^11.5"},
  "autoload": {"psr-4": {"NHK\\Core\\": "public/wp-content/plugins/nhk-core/src/"}},
  "autoload-dev": {"psr-4": {"NHK\\Tests\\": "public/wp-content/plugins/nhk-core/tests/"}},
  "scripts": {"test": "phpunit --configuration phpunit.xml.dist", "test:p4-acceptance": "php tools/p4-acceptance.php", "lint": "find public/wp-content/plugins/nhk-core -name '*.php' -print0 | xargs -0 -n1 php -l", "preflight": "php tools/deployment-preflight.php"}
}
